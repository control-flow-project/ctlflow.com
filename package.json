{
  "name": "@ctlflow/website",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:check": "node scripts/sync-docs.mjs --check",
    "example:sync": "node scripts/fleet-street.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "check": "npm run build && npm test && npm run test:browser",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "typescript": "6.0.3"
  }
}
